# Merge these values into variables.env before starting the service.
# Keep the LLM/VLM connection URLs, model IDs and API keys from your own setup.
# Saved web settings override model settings from the environment; adjust the
# four capacity fields in the web settings too if settings.json already exists.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_CPU_THREADS=4
WHISPER_CHUNK_SECONDS=300

# One shared ASR model; CUDA initialization/inference failure falls back to CPU.
# Do not increase workers just because a GPU is present.
TASK_WORKERS=2
MODEL_CONCURRENCY=2
DOWNLOAD_CONCURRENCY=1
FFMPEG_CONCURRENCY=1
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_SECONDS=21600
FRAME_CONCURRENCY=2

# Context and maximum output are separate provider limits.
LLM_CONTEXT_TOKENS=1000000
VLM_CONTEXT_TOKENS=1000000
LLM_MAX_OUTPUT_TOKENS=8192
VLM_MAX_OUTPUT_TOKENS=8192
MODEL_REQUEST_MB=16

# Large media profile; MiB. Reserve space for input, output and temporary files.
MAX_UPLOAD_MB=16384
MAX_DOWNLOAD_MB=32768
MIN_FREE_DISK_MB=4096
MAX_DURATION_HOURS=24
PDF_TIMEOUT_SECONDS=300
