# Model API format: openai (Chat Completions) or anthropic (Messages)
LLM_API_FORMAT=openai
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_ID=hy-vision-2.0-instruct
LLM_API_KEY=replace-with-your-api-key
# Optional separate multimodal model; missing connection fields fill from the other model.
VLM_API_FORMAT=
VLM_BASE_URL=
VLM_MODEL_ID=
VLM_API_KEY=
# Shared LAN workspace, no login required. One Web process.
HOST=0.0.0.0
# All task files and model weights remain on this machine.
# MEDIA_DATA_DIR=/absolute/path/to/data
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# Parallel background jobs (1-8); Whisper inference stays serialized.
TASK_WORKERS=2
