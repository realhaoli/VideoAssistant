# Model API format: openai (Chat Completions) or anthropic (Messages)
LLM_API_FORMAT=openai
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_ID=hy-vision-2.0-instruct
LLM_API_KEY=replace-with-your-api-key
# Optional separate multimodal model; missing connection fields fill from the other model.
VLM_API_FORMAT=
VLM_BASE_URL=
VLM_MODEL_ID=
VLM_API_KEY=
# Shared LAN workspace, no login required. One Web process.
HOST=0.0.0.0
# All task files and model weights remain on this machine.
# Relative paths use the project root. On Windows prefer forward slashes.
# MEDIA_DATA_DIR=workspace-data
# MEDIA_DATA_DIR=D:/VideoAssistantData
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# GPU model load (including first download) and transcription stall timeouts.
WHISPER_GPU_LOAD_TIMEOUT_SECONDS=1800
WHISPER_GPU_STALL_TIMEOUT_SECONDS=180
# Use local rules for ASR filler cues. Set to model for model-based editing.
ASR_CLEANUP_MODE=local

# Parallel background jobs (1-8); Whisper inference stays serialized.
TASK_WORKERS=2
# Total uploading, waiting, and running tasks. New submissions receive HTTP 429 at this limit.
MAX_PENDING_TASKS=64
# Defaults to 8 or four times TASK_WORKERS, whichever is greater.
# MAX_ACTIVE_TASKS=8

# Configure these separately according to the exact provider/model limits.
LLM_CONTEXT_TOKENS=32768
VLM_CONTEXT_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=8192
VLM_MAX_OUTPUT_TOKENS=8192
# Model response read timeout in seconds (15–600).
MODEL_TIMEOUT_SECONDS=240
# RTX 3070 and large-media settings: variables_gpu_3070_template.env
